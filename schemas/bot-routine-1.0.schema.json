{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Madmaxme/delivery-loop/schemas/bot-routine-1.0.schema.json",
  "title": "delivery-loop bot routine",
  "description": "A described routine. specversion 1.0. trigger is a description. Loading this file does not schedule, subscribe, or call anything. The file names no credential and no endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "effect", "purpose", "trigger", "inputs", "output", "idempotency", "overlap", "approval"],
  "properties": {
    "specversion": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "effect": { "const": "data-only" },
    "purpose": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spec"],
      "properties": {
        "kind": { "enum": ["event", "schedule", "webhook"] },
        "spec": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1, "pattern": "^ref:[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "contract"],
      "properties": {
        "event": { "type": "string", "minLength": 1, "pattern": "^bot\\.routine\\.[a-z0-9-]+\\.reported$" },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency": { "type": "string", "minLength": 1 },
    "overlap": { "enum": ["skip", "queue", "refuse"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "requires"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "requires": { "type": "string", "minLength": 1 }
      }
    }
  }
}
