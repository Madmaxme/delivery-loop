{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Madmaxme/delivery-loop/schemas/bot-manifest-1.0.schema.json",
  "title": "delivery-loop bot manifest",
  "description": "Paths of role definitions, routines, and the inventory, relative to this file's directory. specversion 1.0. effect is data-only. A path is a file reference. The manifest grants nothing. engineering-bot may be omitted. The other three roles are required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "effect", "roles", "routines", "inventory"],
  "properties": {
    "specversion": { "type": "string", "const": "1.0" },
    "effect": { "const": "data-only" },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "verdict-writer", "delivery-agent"],
      "properties": {
        "orchestrator": { "type": "string", "minLength": 1 },
        "verdict-writer": { "type": "string", "minLength": 1 },
        "delivery-agent": { "type": "string", "minLength": 1 },
        "engineering-bot": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "routines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "inventory": { "type": "string", "minLength": 1 }
  }
}
