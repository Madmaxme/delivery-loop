{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Madmaxme/delivery-loop/schemas/bot-definition-1.0.schema.json",
  "title": "delivery-loop bot definition",
  "description": "A role template, or a client instance of that role. specversion 1.0. The file is data. It names no credential and no platform id. An identity is a reference. effect is data-only and cannot grant authority or relax a gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "role", "effect", "purpose", "policies", "authority"],
  "properties": {
    "specversion": { "type": "string", "const": "1.0" },
    "role": { "enum": ["orchestrator", "verdict-writer", "delivery-agent", "engineering-bot"] },
    "effect": { "const": "data-only" },
    "purpose": { "type": "string", "minLength": 1 },
    "identityRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ref:[a-z0-9][a-z0-9-]*$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "adapter", "operation"],
        "properties": {
          "ref": { "type": "string", "pattern": "^ref:[a-z0-9][a-z0-9-]*$" },
          "adapter": { "enum": ["forge", "tracker", "worker", "connector"] },
          "operation": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
        }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "adapter", "purpose"],
        "properties": {
          "ref": { "type": "string", "pattern": "^ref:[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["execution", "commit-actor", "review", "worker", "runner"] },
          "adapter": { "enum": ["forge", "tracker", "worker", "connector", "runner"] },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "no-self-merge",
          "independent-review",
          "checks-on-exact-head",
          "head-pinned-squash",
          "no-rebase",
          "no-merge-on-red",
          "orchestrator-no-dispatch",
          "orchestrator-no-status-writes",
          "verdict-no-status-writes",
          "verdict-no-relax-gate",
          "engineering-no-dispatch",
          "engineering-no-status-writes",
          "engineering-no-relax-gate",
          "engineering-reports-only-to-orchestrator",
          "canonical-call-path"
        ]
      }
    },
    "reportsTo": {
      "enum": ["orchestrator", "verdict-writer", "delivery-agent", "engineering-bot"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may", "mustNot"],
      "properties": {
        "may": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {
                "enum": [
                  "monitor-runs",
                  "report-evidence",
                  "record-verdict",
                  "record-evidence",
                  "call-adapters",
                  "review-independently",
                  "read-checks-on-exact-head",
                  "squash-exact-green-head",
                  "start-delivery-loop",
                  "dispatch-delivery-loop",
                  "write-delivery-status",
                  "write-delivery-label",
                  "merge-own-head",
                  "merge-other-head",
                  "rebase-head",
                  "force-merge-on-red",
                  "relax-quality-gate",
                  "engineer-task",
                  "report-to-orchestrator",
                  "merge-pr",
                  "self-merge",
                  "write-tracker-status"
                ]
              },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        },
        "mustNot": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {
                "enum": [
                  "no-self-merge",
                  "independent-review",
                  "checks-on-exact-head",
                  "head-pinned-squash",
                  "no-rebase",
                  "no-merge-on-red",
                  "orchestrator-no-dispatch",
                  "orchestrator-no-status-writes",
                  "verdict-no-status-writes",
                  "verdict-no-relax-gate",
                  "engineering-no-dispatch",
                  "engineering-no-status-writes",
                  "engineering-no-relax-gate",
                  "engineering-reports-only-to-orchestrator",
                  "canonical-call-path"
                ]
              },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
